# ─── VITALCARE TRAINING HUB — ENVIRONMENT VARIABLES ────────────────────────
# This file is .env.example — COMMIT THIS (no real values)
# Copy to .env.local and fill in real values
# .env.local is in .gitignore — NEVER commit it
# This is a Vite SPA — use VITE_ prefix for browser-exposed vars only
#
# Company: Vitalcare Training Hub Ltd | Co. No. 15718997
# ─────────────────────────────────────────────────────────────────────────────

# ─── APP ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="Vitalcare Training Hub"
VITE_APP_URL="http://localhost:5173"
VITE_SITE_URL="https://vitalcare.uk"
NODE_ENV="development"

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Dashboard: supabase.com/dashboard/project/mongirnapzzizmzcrkqp
# Free tier: 500MB DB, 1GB storage, 50,000 MAU
# SAFE FOR BROWSER: These two only
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# SERVER ONLY — use in Supabase Edge Functions, never in browser code
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# ─── RESEND (Email — 3,000/month free) ──────────────────────────────────────
# Dashboard: resend.com | Via Supabase Edge Function (never expose to browser)
RESEND_API_KEY=""
RESEND_FROM="Vitalcare Training Hub <onboarding@resend.dev>"
ADMIN_EMAIL="gakinz101@gmail.com"
ADMIN_EMAIL_SECONDARY="info@vitalcare.uk"

# ─── GOOGLE AI — Gemini 1.5 Flash ───────────────────────────────────────────
# Dashboard: aistudio.google.com | Free: 15 RPM, 1M tokens/day
# Via Supabase Edge Function (never expose to browser)
GOOGLE_AI_API_KEY=""
GOOGLE_AI_ENABLED="true"
GOOGLE_AI_MODEL="gemini-1.5-flash"

# ─── OPENROUTER (AI fallback — Claude Haiku) ────────────────────────────────
# Dashboard: openrouter.ai | Fallback when Gemini quota hit
# Via Supabase Edge Function (never expose to browser)
OPENROUTER_API_KEY=""
OR_MODEL="anthropic/claude-3.5-haiku"

# ─── ZOOM (Virtual Sessions — developer free tier) ──────────────────────────
# Dashboard: marketplace.zoom.us → Server-to-Server OAuth App
# Required scopes: meeting:write, meeting:read, report:read:list_meeting_participants
# Server-to-Server flow: all calls via Supabase Edge Function
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""             # SERVER ONLY — never in browser
ZOOM_ENABLED="true"
ZOOM_SDK_KEY=""                   # Safe for browser (SDK key only)
ZOOM_SDK_SECRET=""                # SERVER ONLY
VITE_ZOOM_SDK_KEY=""              # Safe: Vite-prefixed for browser SDK use
# Webhook endpoint: https://[vercel-url]/api/webhooks/zoom
# Set after configuring in Zoom Marketplace > Event Subscriptions
ZOOM_WEBHOOK_SECRET_TOKEN=""      # SERVER ONLY

# ─── GOOGLE OAUTH + CALENDAR ────────────────────────────────────────────────
# Console: console.cloud.google.com
# Authorised redirect URIs:
#   http://localhost:5173/auth/callback
#   https://mongirnapzzizmzcrkqp.supabase.co/auth/v1/callback
#   https://[vercel-url]/auth/callback
# Also enable Google provider in Supabase > Auth > Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""           # SERVER ONLY

# Google Calendar API (public read via API key is safe)
VITE_GCAL_API_KEY=""              # Safe for browser (read-only public calendar)
VITE_GCAL_CALENDAR_ID=""          # Safe for browser
VITE_GCAL_ENABLED="true"

# ─── OPENWEATHER (dashboard widget — 1,000 calls/day free) ──────────────────
# openweathermap.org — safe to expose (rate-limited, read-only)
VITE_OPENWEATHER_API_KEY=""

# ─── SLACK (Phase 2 — disabled) ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=""
SLACK_ENABLED="false"

# ─── STRIPE (Phase 2 — disabled) ────────────────────────────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=""  # Safe for browser when enabled
# STRIPE_SECRET_KEY=""            # SERVER ONLY when enabled
# STRIPE_WEBHOOK_SECRET=""        # SERVER ONLY when enabled

