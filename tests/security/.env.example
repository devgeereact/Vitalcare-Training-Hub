# Credentials for the authorisation suite (tests/security).
#
# These sign in as real accounts against the real Supabase project, because
# row-level security is the thing under test and a mock would only test itself.
# Never commit real values: copy this to .env.test.local, which is git-ignored.
#
# Run with:  npm run test:security

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

TEST_SUPER_ADMIN_EMAIL=
TEST_SUPER_ADMIN_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_TRAINER_EMAIL=
TEST_TRAINER_PASSWORD=
TEST_LEARNER_EMAIL=
TEST_LEARNER_PASSWORD=

# A second non-staff account, used to prove one signed-in person cannot read
# another's records. Any non-staff role works (learner, manager, content_editor).
TEST_OTHER_USER_EMAIL=
TEST_OTHER_USER_PASSWORD=

# Set once migration 092 has been applied, to enable the organisation-scoping
# assertions. Leaving it unset skips them rather than failing them.
MIGRATION_092_APPLIED=

# Set once migration 093 has been applied, to enable the assessment enrolment
# and attempt-cap assertions.
MIGRATION_093_APPLIED=
