{
  "name": "vitalcare-training-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run seo:sitemap && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:secrets && npm run test",
    "preview": "vite preview",
    "deploy:check": "cpanel-deploy dist vitalcare.uk --prune --keep cgi-bin --keep tmp --with-htaccess dist/.htaccess",
    "deploy": "npm run build && cpanel-deploy dist vitalcare.uk --prune --keep cgi-bin --keep tmp --with-htaccess dist/.htaccess --go",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test"
  },
  "dependencies": {
